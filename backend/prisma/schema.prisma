generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  RESIDENT
}

enum UserStatus {
  ACTIVE
  PASSIVE
}

enum ApartmentResidentType {
  OWNER
  TENANT
}

enum PaymentScopeType {
  SITE
  BLOCK
  APARTMENTS
}

enum PaymentAllocationStatus {
  PENDING
  PAID
  CANCELLED
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ManagerScopeType {
  SITE
  BLOCK
}

enum AnnouncementTargetType {
  ALL
  SITE
  BLOCK
  APARTMENT
}

enum AnnouncementStatus {
  ACTIVE
  ARCHIVED
}

enum RequestType {
  MAINTENANCE
  COMPLAINT
  SUGGESTION
  GENERAL
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  DONE
  REJECTED
}

enum IntegrationStatus {
  ACTIVE
  PASSIVE
}

enum SmsProvider {
  ILETIMERKEZI
  NETGSM
  TWILIO
}

enum EmailProvider {
  SMTP
  SENDGRID
}

enum AiProvider {
  OPENAI
  GEMINI
  CUSTOM
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationSourceType {
  MANUAL
  PAYMENT_BATCH
  ANNOUNCEMENT
  RESIDENT_REQUEST
  SYSTEM
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model User {
  id                            String                  @id @default(uuid())
  fullName                      String
  email                         String                  @unique
  phone                         String?
  passwordHash                  String
  role                          UserRole
  status                        UserStatus              @default(ACTIVE)
  apartmentResidents            ApartmentResident[]
  uploadedReceipts              PaymentReceipt[]        @relation("UploadedReceipts")
  reviewedReceipts              PaymentReceipt[]        @relation("ReviewedReceipts")
  managerAssignments            ManagerAssignment[]     @relation("ManagerAssignments")
  auditLogs                     AuditLog[]              @relation("UserAuditLogs")
  announcements                 Announcement[]          @relation("UserAnnouncements")
  announcementReads             AnnouncementRead[]      @relation("UserAnnouncementReads")
  createdRequests               ResidentRequest[]       @relation("UserCreatedRequests")
  assignedRequests              ResidentRequest[]       @relation("UserAssignedRequests")
  createdSmsSettings            SmsSetting[]            @relation("UserCreatedSmsSettings")
  updatedSmsSettings            SmsSetting[]            @relation("UserUpdatedSmsSettings")
  createdEmailSettings          EmailSetting[]          @relation("UserCreatedEmailSettings")
  updatedEmailSettings          EmailSetting[]          @relation("UserUpdatedEmailSettings")
  createdAiSettings             AiSetting[]             @relation("UserCreatedAiSettings")
  updatedAiSettings             AiSetting[]             @relation("UserUpdatedAiSettings")
  createdSystemSettings         SystemSetting[]         @relation("UserCreatedSystemSettings")
  updatedSystemSettings         SystemSetting[]         @relation("UserUpdatedSystemSettings")
  createdSystemSecuritySettings SystemSecuritySetting[] @relation("UserCreatedSystemSecuritySettings")
  updatedSystemSecuritySettings SystemSecuritySetting[] @relation("UserUpdatedSystemSecuritySettings")
  createdNotificationLogs       NotificationLog[]       @relation("UserCreatedNotificationLogs")
  receivedNotificationLogs      NotificationLog[]       @relation("UserReceivedNotificationLogs")
  passwordResetTokens           PasswordResetToken[]    @relation("UserPasswordResetTokens")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Site {
  id                 String              @id @default(uuid())
  name               String
  address            String
  description        String?
  imageUrl           String?
  hasElevator        Boolean             @default(false)
  systems            String[]            @default([])
  isActive           Boolean             @default(true)
  blocks             Block[]
  paymentBatches     PaymentBatch[]
  managerAssignments ManagerAssignment[]
  announcements      Announcement[]      @relation("SiteAnnouncements")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Block {
  id          String  @id @default(uuid())
  name        String
  description String?
  imageUrl    String?

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  apartments         Apartment[]
  paymentBatches     PaymentBatch[]
  managerAssignments ManagerAssignment[]
  announcements      Announcement[]      @relation("BlockAnnouncements")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

model Apartment {
  id          String  @id @default(uuid())
  number      String
  floor       Int?
  description String?

  blockId String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  residents          ApartmentResident[]
  paymentAllocations PaymentAllocation[]
  paymentExemptions  PaymentExemption[]
  announcements      Announcement[]      @relation("ApartmentAnnouncements")
  requests           ResidentRequest[]   @relation("ApartmentRequests")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blockId, number])
  @@index([blockId])
}

model ApartmentResident {
  id   String                @id @default(uuid())
  type ApartmentResidentType

  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([apartmentId, userId, type])
  @@index([apartmentId])
  @@index([userId])
}

model PaymentBatch {
  id               String           @id @default(uuid())
  title            String
  description      String?
  totalAmountKurus Int
  scopeType        PaymentScopeType
  dueDate          DateTime

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  blockId String?
  block   Block?  @relation(fields: [blockId], references: [id], onDelete: SetNull)

  allocations PaymentAllocation[]
  exemptions  PaymentExemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([blockId])
  @@index([scopeType])
}

model PaymentAllocation {
  id          String                  @id @default(uuid())
  amountKurus Int
  status      PaymentAllocationStatus @default(PENDING)
  paidAt      DateTime?

  paymentBatchId String
  paymentBatch   PaymentBatch @relation(fields: [paymentBatchId], references: [id], onDelete: Cascade)

  apartmentId String
  apartment   Apartment        @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  receipts    PaymentReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([paymentBatchId, apartmentId])
  @@index([paymentBatchId])
  @@index([apartmentId])
}

model PaymentExemption {
  id String @id @default(uuid())

  paymentBatchId String
  paymentBatch   PaymentBatch @relation(fields: [paymentBatchId], references: [id], onDelete: Cascade)

  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([paymentBatchId, apartmentId])
  @@index([paymentBatchId])
  @@index([apartmentId])
}

model PaymentReceipt {
  id String @id @default(uuid())

  originalFileName String
  storedFileName   String
  mimeType         String
  sizeBytes        Int
  status           ReceiptStatus @default(PENDING)

  note       String?
  reviewNote String?
  reviewedAt DateTime?

  paymentAllocationId String
  paymentAllocation   PaymentAllocation @relation(fields: [paymentAllocationId], references: [id], onDelete: Cascade)

  uploadedByUserId String
  uploadedByUser   User   @relation("UploadedReceipts", fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  reviewedByUserId String?
  reviewedByUser   User?   @relation("ReviewedReceipts", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  aiProvider        AiProvider?
  aiModelName       String?
  aiPayerName       String?
  aiAmountKurus     Int?
  aiApartmentNumber String?
  aiDescription     String?
  aiPaymentDate     String?
  aiConfidence      Float?
  aiAnalyzedAt      DateTime?

  @@index([paymentAllocationId])
  @@index([uploadedByUserId])
  @@index([reviewedByUserId])
  @@index([status])
  @@index([aiProvider])
  @@index([aiAnalyzedAt])
}

model ManagerAssignment {
  id        String           @id @default(uuid())
  scopeType ManagerScopeType

  managerId String
  manager   User   @relation("ManagerAssignments", fields: [managerId], references: [id], onDelete: Cascade)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  blockId String?
  block   Block?  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managerId])
  @@index([siteId])
  @@index([blockId])
  @@index([scopeType])
}

model AuditLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String?

  ipAddress String?
  userAgent String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model Announcement {
  id String @id @default(uuid())

  title   String
  content String

  targetType AnnouncementTargetType
  status     AnnouncementStatus     @default(ACTIVE)

  siteId String?
  site   Site?   @relation("SiteAnnouncements", fields: [siteId], references: [id], onDelete: Cascade)

  blockId String?
  block   Block?  @relation("BlockAnnouncements", fields: [blockId], references: [id], onDelete: Cascade)

  apartmentId String?
  apartment   Apartment? @relation("ApartmentAnnouncements", fields: [apartmentId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdByUser   User?              @relation("UserAnnouncements", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reads           AnnouncementRead[] @relation("AnnouncementReads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType])
  @@index([status])
  @@index([siteId])
  @@index([blockId])
  @@index([apartmentId])
  @@index([createdByUserId])
  @@index([createdAt])
}

model AnnouncementRead {
  id String @id @default(uuid())

  announcementId String
  announcement   Announcement @relation("AnnouncementReads", fields: [announcementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserAnnouncementReads", fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
  @@index([readAt])
}

model ResidentRequest {
  id String @id @default(uuid())

  title       String
  description String

  type   RequestType
  status RequestStatus @default(OPEN)

  apartmentId String
  apartment   Apartment @relation("ApartmentRequests", fields: [apartmentId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdByUser   User?   @relation("UserCreatedRequests", fields: [createdByUserId], references: [id], onDelete: SetNull)

  assignedToUserId String?
  assignedToUser   User?   @relation("UserAssignedRequests", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  attachmentOriginalFileName String?
  attachmentStoredFileName   String?
  attachmentMimeType         String?
  attachmentSizeBytes        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([apartmentId])
  @@index([createdByUserId])
  @@index([assignedToUserId])
  @@index([createdAt])
}

model SmsSetting {
  id String @id @default(uuid())

  provider SmsProvider
  status   IntegrationStatus @default(PASSIVE)

  senderName          String?
  apiKeyEncrypted     String?
  apiSecretEncrypted  String?
  usernameEncrypted   String?
  passwordEncrypted   String?
  accountSidEncrypted String?
  authTokenEncrypted  String?
  fromPhone           String?

  createdByUserId String?
  createdByUser   User?   @relation("UserCreatedSmsSettings", fields: [createdByUserId], references: [id], onDelete: SetNull)

  updatedByUserId String?
  updatedByUser   User?   @relation("UserUpdatedSmsSettings", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([status])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model EmailSetting {
  id String @id @default(uuid())

  provider EmailProvider
  status   IntegrationStatus @default(PASSIVE)

  fromEmail String
  fromName  String?

  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean @default(false)
  smtpUsernameEncrypted String?
  smtpPasswordEncrypted String?

  sendgridApiKeyEncrypted String?

  createdByUserId String?
  createdByUser   User?   @relation("UserCreatedEmailSettings", fields: [createdByUserId], references: [id], onDelete: SetNull)

  updatedByUserId String?
  updatedByUser   User?   @relation("UserUpdatedEmailSettings", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([status])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model AiSetting {
  id String @id @default(uuid())

  provider AiProvider
  status   IntegrationStatus @default(PASSIVE)

  name      String?
  modelName String?
  baseUrl   String?

  apiKeyEncrypted String?

  createdByUserId String?
  createdByUser   User?   @relation("UserCreatedAiSettings", fields: [createdByUserId], references: [id], onDelete: SetNull)

  updatedByUserId String?
  updatedByUser   User?   @relation("UserUpdatedAiSettings", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([status])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model SystemSetting {
  id String @id @default(uuid())

  appName      String  @default("Sitesis")
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  address      String?
  websiteUrl   String?
  supportEmail String?
  supportPhone String?

  createdByUserId String?
  createdByUser   User?   @relation("UserCreatedSystemSettings", fields: [createdByUserId], references: [id], onDelete: SetNull)

  updatedByUserId String?
  updatedByUser   User?   @relation("UserUpdatedSystemSettings", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model NotificationLog {
  id String @id @default(uuid())

  channel    NotificationChannel
  status     NotificationStatus     @default(PENDING)
  sourceType NotificationSourceType

  recipientUserId String?
  recipientUser   User?   @relation("UserReceivedNotificationLogs", fields: [recipientUserId], references: [id], onDelete: SetNull)

  recipientEmail String?
  recipientPhone String?

  subject String?
  message String

  provider          String?
  providerMessageId String?

  entityType String?
  entityId   String?

  errorMessage String?

  metadata Json?

  createdByUserId String?
  createdByUser   User?   @relation("UserCreatedNotificationLogs", fields: [createdByUserId], references: [id], onDelete: SetNull)

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([channel])
  @@index([status])
  @@index([sourceType])
  @@index([recipientUserId])
  @@index([createdByUserId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model ContactMessage {
  id String @id @default(uuid())

  fullName String
  email    String
  phone    String?
  message  String
  status   ContactMessageStatus @default(NEW)

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model SystemSecuritySetting {
  id String @id @default(uuid())

  sessionDurationMinutes Int     @default(60)
  minPasswordLength      Int     @default(8)
  loginAttemptLimit      Int     @default(5)
  lockDurationMinutes    Int     @default(15)
  requireStrongPassword  Boolean @default(true)
  enableTwoFactor        Boolean @default(false)
  allowPublicRegister    Boolean @default(false)
  logSecurityEvents      Boolean @default(true)

  createdByUserId String?
  createdByUser   User?   @relation("UserCreatedSystemSecuritySettings", fields: [createdByUserId], references: [id], onDelete: SetNull)

  updatedByUserId String?
  updatedByUser   User?   @relation("UserUpdatedSystemSecuritySettings", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdByUserId])
  @@index([updatedByUserId])
}
