generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  RESIDENT
}

enum UserStatus {
  ACTIVE
  PASSIVE
}

model User {
  id           String     @id @default(uuid())
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
model Site {
  id          String   @id @default(uuid())
  name        String
  address     String
  description String?
  imageUrl    String?
  hasElevator Boolean  @default(false)
  systems     String[] @default([])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}