generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  MANAGER
  RESIDENT
}

enum UserStatus {
  ACTIVE
  PASSIVE
}

enum ApartmentResidentType {  
  OWNER
  TENANT
}

enum PaymentScopeType {
  SITE
  BLOCK
  APARTMENTS
}

enum PaymentAllocationStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  fullName     String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  apartmentResidents ApartmentResident[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
model Site {
  id          String   @id @default(uuid())
  name        String
  address     String
  description String?
  imageUrl    String?
  hasElevator Boolean  @default(false)
  systems     String[] @default([])

  blocks      Block[]
  paymentBatches PaymentBatch[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Block {
  id          String   @id @default(uuid())
  name        String
  description String?

  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  apartments  Apartment[]
  paymentBatches PaymentBatch[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([siteId])
}

model Apartment {
  id          String   @id @default(uuid())
  number      String
  floor       Int?
  description String?

  blockId     String
  block       Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)

  residents ApartmentResident[]
  paymentAllocations PaymentAllocation[]
  paymentExemptions  PaymentExemption[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([blockId])
  @@unique([blockId, number])
}

model ApartmentResident {
  id          String                @id @default(uuid())
  type        ApartmentResidentType

  apartmentId String
  apartment   Apartment             @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([apartmentId])
  @@index([userId])
  @@unique([apartmentId, userId, type])
}
model PaymentBatch {
  id               String           @id @default(uuid())
  title            String
  description      String?
  totalAmountKurus Int
  scopeType        PaymentScopeType
  dueDate          DateTime

  siteId           String?
  site             Site?            @relation(fields: [siteId], references: [id], onDelete: SetNull)

  blockId          String?
  block            Block?           @relation(fields: [blockId], references: [id], onDelete: SetNull)

  allocations      PaymentAllocation[]
  exemptions       PaymentExemption[]

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([siteId])
  @@index([blockId])
  @@index([scopeType])
}

model PaymentAllocation {
  id               String                  @id @default(uuid())
  amountKurus      Int
  status           PaymentAllocationStatus @default(PENDING)
  paidAt           DateTime?

  paymentBatchId   String
  paymentBatch     PaymentBatch            @relation(fields: [paymentBatchId], references: [id], onDelete: Cascade)

  apartmentId      String
  apartment        Apartment               @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([paymentBatchId])
  @@index([apartmentId])
  @@unique([paymentBatchId, apartmentId])
}

model PaymentExemption {
  id               String       @id @default(uuid())

  paymentBatchId   String
  paymentBatch     PaymentBatch @relation(fields: [paymentBatchId], references: [id], onDelete: Cascade)

  apartmentId      String
  apartment        Apartment    @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  createdAt        DateTime     @default(now())

  @@index([paymentBatchId])
  @@index([apartmentId])
  @@unique([paymentBatchId, apartmentId])
}