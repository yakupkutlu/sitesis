HTTP_PORT=80
APP_URL=http://localhost

POSTGRES_DB=sitesis_db
POSTGRES_USER=sitesis_user
POSTGRES_PASSWORD=change-this-database-password

DATABASE_URL=postgresql://sitesis_user:change-this-database-password@db:5432/sitesis_db?schema=public

JWT_SECRET=change-this-jwt-secret-minimum-32-characters
JWT_EXPIRES_IN=1d
CONFIG_ENCRYPTION_KEY=change-this-config-encryption-key-minimum-32-characters
COOKIE_SAME_SITE=lax
TRUST_PROXY=true

SUPER_ADMIN_FULL_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@sitesis.local
SUPER_ADMIN_PASSWORD=change-this-strong-password-minimum-12-characters

